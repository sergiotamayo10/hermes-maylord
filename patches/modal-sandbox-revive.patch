+def _sandbox_lifetime() -> int:
+    """Hard cap on one sandbox's life (Modal kills it at this age, unsaved work included).
+    Idle sandboxes are still snapshotted and stopped by the idle reaper long before this."""
+    try:
+        value = int(os.environ.get("TERMINAL_MODAL_SANDBOX_LIFETIME", "21600"))
+    except ValueError:
+        value = 21600
+    return max(300, min(value, 86400))  # Modal allows at most 24h
+
+
+_LIVENESS_INTERVAL_S = 5.0
+
