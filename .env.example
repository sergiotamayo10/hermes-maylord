# ── API-key provider examples ──────────────────────────────────────────────
# Alternatively, choose ChatGPT (OAuth) in /setup and authorize with a device
# code. Hermes keeps that login in /data/.hermes/auth.json on your volume;
# do not put ChatGPT access or refresh tokens in .env or Railway variables.

# Recommended: OpenRouter (access to all models via one key)
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-4o-mini

# Or: direct OpenAI
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Or: direct Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5

# ── Optional: Tool APIs ──────────────────────────────────────────────────────

# Web search (pick one or more)
EXA_API_KEY=
FIRECRAWL_API_KEY=
PARALLEL_API_KEY=

# Image generation
FAL_KEY=

# Cross-session user modeling
HONCHO_API_KEY=

# GitHub (higher rate limits for code tools)
GITHUB_TOKEN=

# ── Optional: Browser automation ─────────────────────────────────────────────
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ── Gateway security ──────────────────────────────────────────────────────────
# Keep this false and list your own ids. With no allowlist and no allow-all flag
# every user is denied; Setup warns if allow-all is enabled.
GATEWAY_ALLOW_ALL_USERS=false
TELEGRAM_ALLOWED_USERS=
WHATSAPP_ALLOWED_USERS=

# ── Sandbox for the agent's shell ─────────────────────────────────────────────
# With both Modal values set, terminal commands run in a Modal container that
# receives only GITHUB_TOKEN, instead of in this container next to your keys.
# Set a monthly spend limit in the Modal dashboard.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ── Task tools ────────────────────────────────────────────────────────────────
# ClickUp's official MCP uses OAuth; use this token only as a fallback.
CLICKUP_API_KEY=
